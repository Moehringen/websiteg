{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guo-shuang-article-admin",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-20",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guo-shuang-articles",
      "database_id": "403a8724-2a1f-4dea-be69-fb3ae905e7aa",
      "migrations_dir": "migrations"
    }
  ]
}
